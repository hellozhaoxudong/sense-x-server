<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sense.app.core.user.mapper.SysUserTenantMapper">

    <!--查询用户租户关系信息-->
    <select id="queryUserTenants" resultType="com.sense.app.core.user.domain.SysUserTenant">
        select ut.USER_ID,
        t.ID TENANT_ID,
        t.TENANT_CODE,
        t.TENANT_NAME,
        ut.MAIN_TENANT
        from sys_user_tenant ut
        left join sys_tenant t on ut.TENANT_ID = t.ID
        where ut.USER_ID in
        <foreach collection="userIds" item="userId" index="" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </select>
</mapper>